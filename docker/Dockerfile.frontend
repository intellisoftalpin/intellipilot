# syntax=docker/dockerfile:1.7
#
# Builds the IntelliPilot Flutter web app from source and serves the static
# bundle with nginx. The front repo is cloned at build time at a pinned ref
# so this Dockerfile is self-contained — no sibling checkout required.
#
# Build args (override via docker compose build args or `--build-arg`):
#   FRONTEND_REPO  git URL of the Flutter front-end
#   FRONTEND_REF   branch, tag, or commit SHA to check out
#   FLUTTER_TAG    Flutter SDK image tag (cirruslabs/flutter)
#   API_BASE       value baked into the build via --dart-define so the SPA
#                  talks to /api/ on the same origin (no CORS).

ARG FLUTTER_TAG=stable
ARG FRONTEND_REPO=https://github.com/intellisoftalpin/intellipilot-front.git
ARG FRONTEND_REF=main
ARG API_BASE=/api

# ---------- Stage 1: Flutter build ----------------------------------------
FROM ghcr.io/cirruslabs/flutter:${FLUTTER_TAG} AS build
ARG FRONTEND_REPO
ARG FRONTEND_REF
ARG API_BASE
WORKDIR /src

# Allow non-root git operations inside the Flutter image's home.
RUN git config --global --add safe.directory /src

# Try shallow clone of a branch/tag first; fall back to full clone + checkout
# so commit SHAs also work.
RUN git clone --depth 1 --branch "${FRONTEND_REF}" "${FRONTEND_REPO}" . \
 || (rm -rf ./* ./.[!.]* 2>/dev/null; \
     git clone "${FRONTEND_REPO}" . && git checkout "${FRONTEND_REF}")

RUN flutter --version \
 && flutter config --no-analytics \
 && flutter pub get

RUN flutter build web --release \
      --dart-define=INTELLIPILOT_API_BASE=${API_BASE} \
      --pwa-strategy=offline-first

# ---------- Stage 2: nginx runtime ----------------------------------------
FROM nginx:1.27-alpine AS runtime
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html
EXPOSE 80
