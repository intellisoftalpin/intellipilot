# Example environment for docker/compose.release.yaml.
# Copy to `.env` next to this file and fill in real values. Never commit `.env`.
#   cp docker/.env.example docker/.env
# Generate any random secret with: openssl rand -hex 32

# ---- image tags -----------------------------------------------------------
# Pin specific releases; leave unset to track ":latest" (not recommended for
# production). Tags are bare semver — no leading "v".
# Latest available at time of writing:
#   backend  ghcr.io/intellisoftalpin/intellipilot
#   frontend ghcr.io/intellisoftalpin/intellipilot-front
INTELLIPILOT_VERSION=0.1.13
INTELLIPILOT_FRONT_VERSION=0.1.1

# ---- runtime --------------------------------------------------------------
INTELLIPILOT_ENV=production
INTELLIPILOT_PORT=8080
RUST_LOG=info

# ---- postgres -------------------------------------------------------------
POSTGRES_USER=intellipilot
POSTGRES_DB=intellipilot
# REQUIRED. Use a strong password. The compose file will refuse to start
# without it.
POSTGRES_PASSWORD=replace-me-with-strong-password

# ---- secrets (REQUIRED) ---------------------------------------------------
# Each value is hashed with SHA-256 by the app, so any high-entropy string
# works. Generate fresh values per environment — never reuse between
# staging / production.
#   openssl rand -hex 32
INTELLIPILOT_PASETO_SECRET=replace-me-openssl-rand-hex-32
INTELLIPILOT_PASSWORD_PEPPER=replace-me-openssl-rand-hex-32
INTELLIPILOT_ATTACHMENT_SECRET=replace-me-openssl-rand-hex-32

# ---- attachments ----------------------------------------------------------
# Per-upload size cap in bytes (default 25 MiB).
INTELLIPILOT_ATTACHMENT_MAX_BYTES=26214400

# ---- bootstrap superadmin (V011, all compose files) ----------------------
# On every boot the API checks for at least one active superadmin:
#   * If one already exists, these vars are ignored.
#   * Otherwise:
#       - if EMAIL matches an existing user, that user is promoted (password
#         unchanged); or
#       - if no such user exists and PASSWORD is set, a new superadmin is
#         created with these credentials;
#       - production refuses to start when no path produces an admin.
# Safe to leave set after first boot — the bootstrap is idempotent.
INTELLIPILOT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INTELLIPILOT_BOOTSTRAP_ADMIN_PASSWORD=replace-me-strong-bootstrap-password
# Optional. Default username = local-part of email; default full_name = username.
#INTELLIPILOT_BOOTSTRAP_ADMIN_USERNAME=admin
#INTELLIPILOT_BOOTSTRAP_ADMIN_FULL_NAME=Site Admin

# ---- WebAuthn / passkeys (set for production hosts) -----------------------
# Only used by compose.release.yaml. compose.full.yaml derives RP_ID/RP_ORIGIN
# from DOMAIN automatically — leave these unset there.
# rp_id must be the registrable domain (no scheme, no port).
# rp_origin must be the exact origin (scheme + host + optional port).
INTELLIPILOT_RP_ID=intellipilot.example.com
INTELLIPILOT_RP_ORIGIN=https://intellipilot.example.com
INTELLIPILOT_RP_NAME=IntelliPilot

# ===========================================================================
# compose.full.yaml only — public stack with nginx-proxy + Let's Encrypt
# ===========================================================================

# REQUIRED. The public hostname; DNS must already point to this server.
# Used as the TLS SAN and as the WebAuthn rp_id / rp_origin.
DOMAIN=intellipilot.example.com
# REQUIRED. Email address Let's Encrypt notifies about expiring certs.
LE_EMAIL=ops@example.com
# Flip to the staging endpoint while testing to avoid LE rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_URI=https://acme-v02.api.letsencrypt.org/directory

# Upload size limit at the proxy. Keep ≥ INTELLIPILOT_ATTACHMENT_MAX_BYTES
# plus a few MB of multipart overhead.
PROXY_CLIENT_MAX_BODY_SIZE=32m

# ===========================================================================
# compose.proxied.yaml only — no-TLS stack (local testing or behind an
# external TLS terminator). All values below have safe local-dev defaults
# in the compose file; override here for staging/production.
# ===========================================================================

# Host port to expose the unified endpoint on.
INTELLIPILOT_PORT=8080
# 127.0.0.1 keeps it private to the host. Set to 0.0.0.0 when an external
# reverse proxy on another machine needs to reach it.
INTELLIPILOT_BIND_ADDR=127.0.0.1
# Public host + origin as seen by browsers (used for WebAuthn rp_id/origin).
# Local default works as-is; override when behind a real proxy.
INTELLIPILOT_PUBLIC_HOST=localhost
INTELLIPILOT_PUBLIC_ORIGIN=http://localhost:8080

